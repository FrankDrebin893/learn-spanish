@page "/quiz"
@using SpanishWordLearner.Models
@using SpanishWordLearner.Services
@inject WordService WordService
@inject ProgressService ProgressService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Práctica y Cuestionarios | Aprende Español</PageTitle>

<div style="max-width: 600px; margin: 0 auto;">

@if (!_quizStarted)
{
    <!-- Quiz Setup Screen -->
    <div class="text-center mb-6">
        <div class="d-inline-flex align-center px-3 py-1 mb-2" style="background: #FEF3E7; border: 1px solid #FCD34D; border-radius: 20px; gap: 8px;">
            <MudIcon Icon="@Icons.Material.Rounded.Timer" Size="Size.Small" Style="color: #D97706;" />
            <span style="font-size: 0.82rem; font-weight: 700; color: #B45309;">ENTRENAMIENTO INTERACTIVO</span>
        </div>
        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #1C1917;">Cuestionario de Vocabulario</MudText>
        <MudText Typo="Typo.body2" Style="color: #57534E;">
            Selecciona tus preferencias para poner a prueba tu velocidad y retención.
        </MudText>
    </div>

    <MudPaper Elevation="0" Class="tierra-card pa-6 mb-6">
        <MudSelect T="int" Label="Número de preguntas" @bind-Value="_questionCount" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem Value="5">5 preguntas (rápido)</MudSelectItem>
            <MudSelectItem Value="10">10 preguntas (estándar)</MudSelectItem>
            <MudSelectItem Value="20">20 preguntas (completo)</MudSelectItem>
            <MudSelectItem Value="50">50 preguntas (maratón)</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Label="Tipo de prueba" @bind-Value="_quizType" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem Value="@("SpanishToEnglish")">Español ➔ Inglés</MudSelectItem>
            <MudSelectItem Value="@("EnglishToSpanish")">Inglés ➔ Español</MudSelectItem>
            <MudSelectItem Value="@("Mixed")">Mixto (ambas direcciones)</MudSelectItem>
        </MudSelect>

        <MudSelect T="int" Label="Rango de dificultad" @bind-Value="_frequencyScope" Variant="Variant.Outlined" Class="mb-6">
            <MudSelectItem Value="100">Top 100 palabras (esencial)</MudSelectItem>
            <MudSelectItem Value="500">Top 500 palabras (intermedio)</MudSelectItem>
            <MudSelectItem Value="1000">Top 1,000 palabras (avanzado)</MudSelectItem>
            <MudSelectItem Value="10000">Todo el vocabulario (10,000)</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                   OnClick="StartQuiz" StartIcon="@Icons.Material.Rounded.PlayArrow"
                   Style="border-radius: 12px; height: 50px; font-weight: 700; text-transform: none;">
            Comenzar Prueba
        </MudButton>
    </MudPaper>
}
else if (_quizComplete)
{
    <!-- Quiz Complete Celebration Screen -->
    <MudPaper Elevation="0" Class="tierra-card pa-8 text-center mb-6">
        <div style="@($"width: 72px; height: 72px; border-radius: 50%; background: {(_accuracy >= 70 ? "#FEF3E7" : "#FDEEEB")}; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center;")">
            <MudIcon Icon="@(_accuracy >= 70 ? Icons.Material.Rounded.EmojiEvents : Icons.Material.Rounded.School)"
                     Size="Size.Large" Style="@($"color: {(_accuracy >= 70 ? "#D97706" : "#D9483B")}; font-size: 40px;")" />
        </div>

        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #1C1917;" Class="mb-1">
            ¡Prueba Completada!
        </MudText>
        <MudText Typo="Typo.body2" Style="color: #78716C;" Class="mb-4">
            @GetAccuracyMessage()
        </MudText>

        <div class="pa-4 rounded-xl my-4" style="background: #FAF8F5; border: 1px solid #EBE6DE;">
            <div style="font-size: 3rem; font-weight: 800; color: @GetAccuracyColor(); line-height: 1;">
                @_correctAnswers <span style="font-size: 1.5rem; color: #78716C; font-weight: 600;">/ @_questions.Count</span>
            </div>
            <div style="font-size: 1rem; font-weight: 700; color: #57534E; margin-top: 6px;">
                Precisión: @_accuracy.ToString("F0")%
            </div>
        </div>

        @if (_missedWords.Count > 0)
        {
            <div class="mt-6 text-left">
                <div class="d-flex align-center gap-1 mb-3" style="font-size: 0.85rem; font-weight: 700; color: #D9483B;">
                    <MudIcon Icon="@Icons.Material.Rounded.Replay" Size="Size.Small" /> Palabras para repasar (@_missedWords.Count)
                </div>
                <div class="d-flex flex-column gap-2 mb-6">
                    @foreach (var word in _missedWords)
                    {
                        <div class="d-flex justify-space-between align-center pa-3 rounded-lg" style="background: #FFFFFF; border: 1px solid #EBE6DE;">
                            <div>
                                <span style="font-weight: 700; color: #1C1917; font-size: 1.05rem;">@word.Spanish</span>
                                <span style="font-size: 0.85rem; color: #78716C; margin-left: 8px;">@word.English</span>
                            </div>
                            <button class="audio-btn" style="width: 32px; height: 32px;" @onclick="@(() => PlaySpanishAudio(word.Spanish))">
                                <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Small" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="d-flex gap-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                       OnClick="RestartQuiz" StartIcon="@Icons.Material.Rounded.Refresh"
                       Style="border-radius: 12px; height: 48px; font-weight: 700; text-transform: none;">
                Repetir Prueba
            </MudButton>
            <div class="d-flex gap-3 w-100">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Size="Size.Large"
                           OnClick="ExitQuiz" StartIcon="@Icons.Material.Rounded.Tune"
                           Style="border-radius: 12px; height: 48px; font-weight: 700; text-transform: none; border-color: #EBE6DE;">
                    Configurar
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Size="Size.Large"
                           OnClick="GoHome" StartIcon="@Icons.Material.Rounded.Home"
                           Style="border-radius: 12px; height: 48px; font-weight: 700; text-transform: none; border-color: #EBE6DE;">
                    Volver al Inicio
                </MudButton>
            </div>
        </div>
    </MudPaper>
}
else if (_currentQuestion != null)
{
    <!-- Active Quiz Question Screen -->
    <div class="d-flex justify-space-between align-center mb-3 px-1">
        <span style="font-size: 0.85rem; font-weight: 700; color: #78716C;">
            Pregunta @(_currentQuestionIndex + 1) de @_questions.Count
        </span>
        @if (_currentStreak > 1)
        {
            <div class="d-flex align-center gap-1 px-2 py-0.5 rounded-pill" style="background: #FEF3E7; border: 1px solid #FCD34D;">
                <MudIcon Icon="@Icons.Material.Rounded.LocalFireDepartment" Size="Size.Small" Style="color: #D97706;" />
                <span style="font-size: 0.78rem; font-weight: 700; color: #B45309;">@_currentStreak en racha</span>
            </div>
        }
    </div>

    <MudProgressLinear Color="Color.Primary" Rounded="true"
                       Value="@((_currentQuestionIndex + 1) * 100.0 / _questions.Count)"
                       Class="mb-5" Style="height: 8px; background-color: #EBE6DE;" />

    <MudPaper Elevation="0" Class="tierra-card pa-6 mb-6">
        <!-- Question Header Prompt -->
        <div class="text-center mb-6">
            <span style="font-size: 0.85rem; font-weight: 600; color: #78716C; display: block; margin-bottom: 6px;">
                @(_currentQuestion.IsSpanishToEnglish ? "¿Cuál es el significado en inglés de:" : "¿Cómo se dice en español:")
            </span>

            <div class="d-flex align-center justify-center gap-2">
                <span style="font-size: 2.25rem; font-weight: 800; color: #1C1917; letter-spacing: -0.01em;">
                    @(_currentQuestion.IsSpanishToEnglish ? _currentQuestion.Word.Spanish : _currentQuestion.Word.English)
                </span>
                @if (_currentQuestion.IsSpanishToEnglish)
                {
                    <button class="audio-btn" style="width: 38px; height: 38px;" @onclick="@(() => PlaySpanishAudio(_currentQuestion.Word.Spanish))" title="Escuchar">
                        <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Small" />
                    </button>
                }
            </div>

            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="mt-2" Style="font-weight: 600;">
                @_currentQuestion.Word.PartOfSpeech
            </MudChip>
        </div>

        <!-- Multiple Choice Options -->
        <div class="d-flex flex-column gap-3 mb-6">
            @for (int i = 0; i < _currentQuestion.Options.Count; i++)
            {
                var option = _currentQuestion.Options[i];
                var optionNum = i + 1;
                var optionText = _currentQuestion.IsSpanishToEnglish ? option.English : option.Spanish;
                var isSelected = _selectedAnswer == option;
                var isCorrect = option.Id == _currentQuestion.Word.Id;

                <button class="quiz-option-btn pa-4 text-left w-100 d-flex align-center justify-space-between"
                        style="@GetOptionStyle(option, isSelected, isCorrect)"
                        disabled="@_answerSelected"
                        @onclick="@(() => SelectAnswer(option))">
                    <div class="d-flex align-center gap-3">
                        <span class="kbd-pill" style="min-width: 24px; text-align: center;">@optionNum</span>
                        <span style="font-weight: 600; font-size: 1rem;">@optionText</span>
                    </div>

                    @if (_answerSelected)
                    {
                        @if (isCorrect)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                        else if (isSelected)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Small" />
                        }
                    }
                </button>
            }
        </div>

        <!-- Next / Advance Button -->
        @if (_answerSelected)
        {
            <div class="d-flex flex-column gap-2 animate-fadeIn">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           OnClick="NextQuestion" EndIcon="@Icons.Material.Rounded.ArrowForward"
                           Style="border-radius: 12px; height: 50px; font-weight: 700; text-transform: none;">
                    @(_currentQuestionIndex < _questions.Count - 1 ? "Siguiente Pregunta (Enter)" : "Ver Resultados")
                </MudButton>
            </div>
        }
    </MudPaper>

    <!-- Keyboard Shortcuts Hint -->
    <div class="d-flex justify-center gap-3 text-center" style="font-size: 0.78rem; color: #78716C;">
        <span><span class="kbd-pill">1-4</span> Seleccionar</span>
        <span><span class="kbd-pill">Enter</span> Continuar</span>
    </div>
}

</div>

@code {
    private int _questionCount = 10;
    private string _quizType = "SpanishToEnglish";
    private int _frequencyScope = 500;

    private bool _quizStarted = false;
    private bool _quizComplete = false;
    private bool _answerSelected = false;

    private List<QuizQuestion> _questions = new();
    private int _currentQuestionIndex = 0;
    private QuizQuestion? _currentQuestion;
    private SpanishWord? _selectedAnswer;

    private int _correctAnswers = 0;
    private int _currentStreak = 0;
    private double _accuracy = 0;
    private List<SpanishWord> _missedWords = new();

    private DotNetObjectReference<Quiz>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("quizKeyboardHandler.init", _dotNetRef);
    }

    [JSInvokable]
    public void HandleKeyDown(string key)
    {
        if (!_quizStarted || _quizComplete) return;

        if (!_answerSelected && _currentQuestion != null)
        {
            int index = key switch
            {
                "1" => 0,
                "2" => 1,
                "3" => 2,
                "4" => 3,
                _ => -1
            };

            if (index >= 0 && index < _currentQuestion.Options.Count)
            {
                SelectAnswer(_currentQuestion.Options[index]);
                StateHasChanged();
            }
        }
        else if (_answerSelected && (key == "Enter" || key == " "))
        {
            NextQuestion();
            StateHasChanged();
        }
    }

    private void StartQuiz()
    {
        var pool = WordService.GetWordsByFrequency(_frequencyScope);
        if (pool.Count < 4)
        {
            pool = WordService.GetAllWords();
        }

        var selectedWords = pool.OrderBy(_ => Random.Shared.Next()).Take(_questionCount).ToList();
        _questions = new List<QuizQuestion>();

        foreach (var word in selectedWords)
        {
            var isSpanishToEnglish = _quizType switch
            {
                "SpanishToEnglish" => true,
                "EnglishToSpanish" => false,
                _ => Random.Shared.Next(2) == 0
            };

            var wrongOptions = WordService.GetRandomWords(3, new List<int> { word.Id });
            var options = new List<SpanishWord> { word };
            options.AddRange(wrongOptions);
            options = options.OrderBy(_ => Random.Shared.Next()).ToList();

            _questions.Add(new QuizQuestion
            {
                Word = word,
                Options = options,
                IsSpanishToEnglish = isSpanishToEnglish
            });
        }

        _currentQuestionIndex = 0;
        _correctAnswers = 0;
        _currentStreak = 0;
        _missedWords.Clear();
        _quizStarted = true;
        _quizComplete = false;
        _answerSelected = false;
        _currentQuestion = _questions.Count > 0 ? _questions[0] : null;

        if (_currentQuestion != null && _currentQuestion.IsSpanishToEnglish)
        {
            _ = PlaySpanishAudio(_currentQuestion.Word.Spanish);
        }
    }

    private async void SelectAnswer(SpanishWord option)
    {
        if (_answerSelected || _currentQuestion == null) return;

        _answerSelected = true;
        _selectedAnswer = option;
        var correct = option.Id == _currentQuestion.Word.Id;

        if (correct)
        {
            _correctAnswers++;
            _currentStreak++;
        }
        else
        {
            _currentStreak = 0;
            _missedWords.Add(_currentQuestion.Word);
        }

        await ProgressService.RecordAnswerAsync(_currentQuestion.Word.Id, correct);
    }

    private void NextQuestion()
    {
        if (_currentQuestionIndex < _questions.Count - 1)
        {
            _currentQuestionIndex++;
            _currentQuestion = _questions[_currentQuestionIndex];
            _selectedAnswer = null;
            _answerSelected = false;

            if (_currentQuestion.IsSpanishToEnglish)
            {
                _ = PlaySpanishAudio(_currentQuestion.Word.Spanish);
            }
        }
        else
        {
            FinishQuiz();
        }
    }

    private async void FinishQuiz()
    {
        _quizComplete = true;
        _accuracy = _questions.Count > 0 ? (_correctAnswers * 100.0 / _questions.Count) : 0;

        var session = new QuizSession
        {
            Date = DateTime.UtcNow,
            TotalQuestions = _questions.Count,
            CorrectAnswers = _correctAnswers,
            WordIdsTested = _questions.Select(q => q.Word.Id).ToList()
        };
        await ProgressService.RecordQuizSessionAsync(session);
        StateHasChanged();
    }

    private void RestartQuiz()
    {
        StartQuiz();
    }

    private void ExitQuiz()
    {
        _quizStarted = false;
        _quizComplete = false;
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("");
    }

    private async Task PlaySpanishAudio(string text)
    {
        await JS.InvokeVoidAsync("spanishSpeech.speak", text);
    }

    private string GetOptionStyle(SpanishWord option, bool isSelected, bool isCorrect)
    {
        if (!_answerSelected) return "";

        if (isCorrect)
        {
            return "border-color: #16A34A !important; background-color: #ECFDF5 !important; color: #15803D !important;";
        }
        if (isSelected && !isCorrect)
        {
            return "border-color: #DC2626 !important; background-color: #FEF2F2 !important; color: #B91C1C !important;";
        }
        return "opacity: 0.6;";
    }

    private string GetAccuracyColor() => _accuracy switch
    {
        >= 80 => "#16A34A",
        >= 60 => "#E0872E",
        _ => "#D9483B"
    };

    private string GetAccuracyMessage() => _accuracy switch
    {
        100 => "¡Extraordinario! Puntuación perfecta 🌟",
        >= 80 => "¡Excelente trabajo! Dominas este vocabulario.",
        >= 60 => "Buen intento. Sigue practicando para consolidar.",
        _ => "¡Ánimo! La práctica constante hace al maestro."
    };

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            await JS.InvokeVoidAsync("quizKeyboardHandler.dispose");
            _dotNetRef.Dispose();
        }
    }

    private class QuizQuestion
    {
        public required SpanishWord Word { get; set; }
        public required List<SpanishWord> Options { get; set; }
        public bool IsSpanishToEnglish { get; set; }
    }
}
