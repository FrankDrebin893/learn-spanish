@page "/quiz"
@using SpanishWordLearner.Models
@using SpanishWordLearner.Services
@inject WordService WordService
@inject ProgressService ProgressService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Práctica y Cuestionarios | Aprende Español</PageTitle>

<div style="max-width: 820px; margin: 0 auto;">

@if (!_quizStarted)
{
    <!-- Quiz Setup Screen -->
    <div class="text-center mb-3 mb-sm-6 pt-1 pt-sm-2 quiz-setup-header">
        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #1C1917; letter-spacing: -0.02em;" Class="mb-1">
            Cuestionario de Vocabulario
        </MudText>
        <MudText Typo="Typo.body2" Style="color: #57534E; font-size: 0.95rem;">
            Personaliza tu prueba para medir tu retención y consolidar palabras activas.
        </MudText>
    </div>

    <MudPaper Elevation="0" Class="tierra-card quiz-setup-card pa-4 pa-sm-6 pa-md-8 mb-4 mb-sm-6">
        <div class="d-flex flex-column gap-3 gap-sm-4 mb-4 mb-sm-6">
            <MudSelect T="int" Label="Número de preguntas" @bind-Value="_questionCount" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="5">5 preguntas (rápido · ~1 min)</MudSelectItem>
                <MudSelectItem Value="10">10 preguntas (estándar · ~2 min)</MudSelectItem>
                <MudSelectItem Value="20">20 preguntas (completo · ~5 min)</MudSelectItem>
                <MudSelectItem Value="50">50 preguntas (maratón)</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" Label="Dirección del reto" @bind-Value="_quizType" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@("SpanishToEnglish")">Español ➔ Inglés (Reconocimiento)</MudSelectItem>
                <MudSelectItem Value="@("EnglishToSpanish")">Inglés ➔ Español (Producción activa)</MudSelectItem>
                <MudSelectItem Value="@("Mixed")">Mixto (ambas direcciones)</MudSelectItem>
            </MudSelect>

            <MudSelect T="int" Label="Rango de vocabulario" @bind-Value="_frequencyScope" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="100">Top 100 palabras (esenciales cotidianas)</MudSelectItem>
                <MudSelectItem Value="500">Top 500 palabras (intermedio)</MudSelectItem>
                <MudSelectItem Value="1000">Top 1,000 palabras (avanzado)</MudSelectItem>
                <MudSelectItem Value="10000">Todo el repertorio (10,000)</MudSelectItem>
            </MudSelect>
        </div>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                   OnClick="StartQuiz" StartIcon="@Icons.Material.Rounded.PlayArrow"
                   Class="quiz-start-btn"
                   Style="border-radius: 12px; height: 48px; font-weight: 700; font-size: 1rem; text-transform: none; box-shadow: 0 4px 14px rgba(217, 72, 59, 0.28);">
            Comenzar Cuestionario
        </MudButton>
    </MudPaper>
}
else if (_quizComplete)
{
    <!-- Quiz Complete Celebration Screen -->
    <MudPaper Elevation="0" Class="tierra-hero-card quiz-celebration-card pa-4 pa-sm-6 pa-md-8 text-center mb-4 mb-sm-6">
        <div class="quiz-celebration-icon" style="@($"border-radius: 50%; background: {(_accuracy >= 70 ? "#FEF3E7" : "#FDEEEB")}; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center;")">
            <MudIcon Icon="@(_accuracy >= 70 ? Icons.Material.Rounded.EmojiEvents : Icons.Material.Rounded.School)"
                     Size="Size.Large" Style="@($"color: {(_accuracy >= 70 ? "#D97706" : "#D9483B")};")" />
        </div>

        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #1C1917; letter-spacing: -0.01em;" Class="mb-1">
            ¡Prueba Finalizada!
        </MudText>
        <MudText Typo="Typo.body2" Style="color: #78716C;" Class="mb-3">
            @GetAccuracyMessage()
        </MudText>

        <!-- Big Score Hero -->
        <div class="pa-3 pa-sm-4 rounded-xl my-3 text-center" style="background: #FAF8F5; border: 1px solid #EBE6DE;">
            <div class="tabular-numbers quiz-score-display" style="font-weight: 800; color: #1C1917; line-height: 1;">
                @_correctAnswers <span style="font-size: 1.3rem; color: #78716C; font-weight: 600;">/ @_questions.Count</span>
            </div>
            <div class="mt-1.5">
                <span class="d-inline-flex align-center px-2.5 py-0.5 rounded-pill" style="@($"background: {(_accuracy >= 70 ? "#ECFDF5" : "#FEF2F2")}; color: {(_accuracy >= 70 ? "#16A34A" : "#DC2626")}; font-weight: 700; font-size: 0.85rem;")">
                    Precisión final: @_accuracy.ToString("F0")%
                </span>
            </div>
        </div>

        @if (_missedWords.Count > 0)
        {
            <div class="mt-4 mb-3 text-left">
                <div class="d-flex align-center gap-1 mb-2" style="font-size: 0.82rem; font-weight: 700; color: #D9483B;">
                    <MudIcon Icon="@Icons.Material.Rounded.Replay" Size="Size.Small" />
                    <span>Palabras para reforzar (@_missedWords.Count)</span>
                </div>
                <div class="d-flex flex-column gap-1.5 quiz-missed-list" style="max-height: 160px; overflow-y: auto; padding-right: 4px;">
                    @foreach (var word in _missedWords)
                    {
                        <div class="d-flex justify-space-between align-center pa-2 px-3 rounded-lg" style="background: #FFFFFF; border: 1px solid #EBE6DE;">
                            <div>
                                <span style="font-weight: 700; color: #1C1917; font-size: 0.95rem;">@word.Spanish</span>
                                <span style="font-size: 0.82rem; color: #78716C; margin-left: 6px;">@word.English</span>
                            </div>
                            <button class="audio-btn" style="width: 28px; height: 28px;" @onclick="@(() => PlaySpanishAudio(word.Spanish))" title="Escuchar">
                                <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Small" Style="font-size: 16px;" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-3 pt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Medium"
                       OnClick="RestartQuiz" StartIcon="@Icons.Material.Rounded.Refresh"
                       Style="border-radius: 12px; height: 44px; font-weight: 700; text-transform: none; box-shadow: 0 4px 12px rgba(217, 72, 59, 0.2);">
                Repetir Prueba
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Size="Size.Medium"
                       OnClick="ExitQuiz" StartIcon="@Icons.Material.Rounded.Tune"
                       Style="border-radius: 12px; height: 44px; font-weight: 700; text-transform: none; border-color: #DFD7CC; color: #57534E;">
                Nueva Configuración
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Size="Size.Medium"
                       OnClick="GoHome" StartIcon="@Icons.Material.Rounded.Home"
                       Style="border-radius: 12px; height: 44px; font-weight: 600; text-transform: none; color: #78716C;">
                Inicio
            </MudButton>
        </div>
    </MudPaper>
}
else if (_currentQuestion != null)
{
    <!-- Active Quiz Question Screen with Directional Compass Layout (1-Screen Optimized) -->
    <div class="quiz-active-viewport">
        <div class="d-flex justify-space-between align-center mb-1 mb-sm-2 px-1 quiz-active-header">
            <div class="d-flex align-baseline gap-2">
                <span class="tabular-numbers" style="font-size: 0.92rem; font-weight: 700; color: #1C1917;">
                    Pregunta @(_currentQuestionIndex + 1)
                </span>
                <span class="tabular-numbers" style="font-size: 0.8rem; font-weight: 500; color: #78716C;">
                    de @_questions.Count
                </span>
            </div>
            @if (_currentStreak > 1)
            {
                <div class="d-flex align-center gap-1 px-2.5 py-0.5 rounded-pill" style="background: #FEF3E7; border: 1px solid #FCD34D;">
                    <MudIcon Icon="@Icons.Material.Rounded.LocalFireDepartment" Size="Size.Small" Style="color: #D97706; font-size: 16px;" />
                    <span class="tabular-numbers" style="font-size: 0.76rem; font-weight: 700; color: #B45309;">@_currentStreak en racha</span>
                </div>
            }
        </div>

        <MudProgressLinear Color="Color.Primary" Rounded="true"
                           Value="@((_currentQuestionIndex + 1) * 100.0 / _questions.Count)"
                           Class="mb-2 mb-sm-4 quiz-progress" Style="height: 4px; background-color: #EBE6DE;" />

        <!-- Question Card with Smooth Fade-Out / Fade-In Animation -->
        <div class="quiz-card-stage @GetTransitionClass()">
            <MudPaper Elevation="0" Class="tierra-card quiz-question-paper pa-3 pa-sm-4 pa-md-6 mb-2 mb-sm-4">
                <div class="quiz-compass-grid" @key="@_currentQuestionIndex">
                    <!-- TOP OPTION (↑ Arriba) -->
                    @if (_currentQuestion.Options.Count > 0)
                    {
                        var optTop = _currentQuestion.Options[0];
                        var isSelected = _selectedAnswer == optTop;
                        var isCorrect = optTop.Id == _currentQuestion.Word.Id;

                        <button @key="@($"{_currentQuestionIndex}_{optTop.Id}")"
                                class="quiz-compass-btn quiz-compass-btn-top"
                                style="@GetOptionStyle(optTop, isSelected, isCorrect)"
                                disabled="@(!_isAcceptingInput || _answerSelected)"
                                @onclick="@(() => SelectAnswer(optTop))">
                            <div class="d-flex align-center gap-2 gap-sm-3" style="min-width: 0;">
                                <span class="kbd-pill-arrow">↑</span>
                                <span class="quiz-option-text">@GetOptionText(optTop)</span>
                            </div>
                            @if (_answerSelected)
                            {
                                @if (isCorrect)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" Class="quiz-result-icon" />
                                }
                                else if (isSelected)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Small" Class="quiz-result-icon" />
                                }
                            }
                        </button>
                    }

                    <!-- LEFT OPTION (← Izquierda) -->
                    @if (_currentQuestion.Options.Count > 1)
                    {
                        var optLeft = _currentQuestion.Options[1];
                        var isSelected = _selectedAnswer == optLeft;
                        var isCorrect = optLeft.Id == _currentQuestion.Word.Id;

                        <button @key="@($"{_currentQuestionIndex}_{optLeft.Id}")"
                                class="quiz-compass-btn quiz-compass-btn-left"
                                style="@GetOptionStyle(optLeft, isSelected, isCorrect)"
                                disabled="@(!_isAcceptingInput || _answerSelected)"
                                @onclick="@(() => SelectAnswer(optLeft))">
                            <div class="d-flex align-center gap-2 gap-sm-3 flex-sm-column flex-row" style="min-width: 0;">
                                <span class="kbd-pill-arrow">←</span>
                                <span class="quiz-option-text">@GetOptionText(optLeft)</span>
                            </div>
                            @if (_answerSelected)
                            {
                                @if (isCorrect)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" Class="quiz-result-icon" />
                                }
                                else if (isSelected)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Small" Class="quiz-result-icon" />
                                }
                            }
                        </button>
                    }

                    <!-- CENTER WORD STAGE (Palabra Central) -->
                    <div class="quiz-compass-center">
                        <span class="quiz-prompt-label">
                            @(_currentQuestion.IsSpanishToEnglish ? "¿Traducción al inglés?" : "¿Cómo se dice en español?")
                        </span>

                        <div class="d-flex align-center justify-center gap-2 flex-wrap my-0.5">
                            <span class="quiz-target-word">
                                @(_currentQuestion.IsSpanishToEnglish ? _currentQuestion.Word.Spanish : _currentQuestion.Word.English)
                            </span>
                            @if (_currentQuestion.IsSpanishToEnglish)
                            {
                                <button class="audio-btn quiz-audio-btn" @onclick="@(() => PlaySpanishAudio(_currentQuestion.Word.Spanish))" title="Escuchar pronunciación">
                                    <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Small" />
                                </button>
                            }
                        </div>

                        <span class="quiz-pos-label">
                            @_currentQuestion.Word.PartOfSpeech
                        </span>

                        @if (_answerSelected)
                        {
                            <div class="quiz-feedback-pill mt-1 animate-fadeIn" style="cursor: pointer;" @onclick="SkipAdvanceDelay" title="Toca para continuar">
                                @if (_selectedAnswer?.Id == _currentQuestion.Word.Id)
                                {
                                    <span class="px-2.5 py-0.5 rounded-pill d-inline-flex align-center gap-1" style="background: #ECFDF5; color: #15803D; font-weight: 700; font-size: 0.8rem;">
                                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Size="Size.Small" Style="font-size: 15px;" />
                                        ¡Correcto!
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-0.5 rounded-pill d-inline-flex align-center gap-1" style="background: #FEF2F2; color: #B91C1C; font-weight: 700; font-size: 0.8rem;">
                                        <MudIcon Icon="@Icons.Material.Rounded.Cancel" Size="Size.Small" Style="font-size: 15px;" />
                                        Incorrecto
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- RIGHT OPTION (→ Derecha) -->
                    @if (_currentQuestion.Options.Count > 2)
                    {
                        var optRight = _currentQuestion.Options[2];
                        var isSelected = _selectedAnswer == optRight;
                        var isCorrect = optRight.Id == _currentQuestion.Word.Id;

                        <button @key="@($"{_currentQuestionIndex}_{optRight.Id}")"
                                class="quiz-compass-btn quiz-compass-btn-right"
                                style="@GetOptionStyle(optRight, isSelected, isCorrect)"
                                disabled="@(!_isAcceptingInput || _answerSelected)"
                                @onclick="@(() => SelectAnswer(optRight))">
                            <div class="d-flex align-center gap-2 gap-sm-3 flex-sm-column flex-row" style="min-width: 0;">
                                <span class="kbd-pill-arrow">→</span>
                                <span class="quiz-option-text">@GetOptionText(optRight)</span>
                            </div>
                            @if (_answerSelected)
                            {
                                @if (isCorrect)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" Class="quiz-result-icon" />
                                }
                                else if (isSelected)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Small" Class="quiz-result-icon" />
                                }
                            }
                        </button>
                    }

                    <!-- BOTTOM OPTION (↓ Abajo) -->
                    @if (_currentQuestion.Options.Count > 3)
                    {
                        var optBottom = _currentQuestion.Options[3];
                        var isSelected = _selectedAnswer == optBottom;
                        var isCorrect = optBottom.Id == _currentQuestion.Word.Id;

                        <button @key="@($"{_currentQuestionIndex}_{optBottom.Id}")"
                                class="quiz-compass-btn quiz-compass-btn-bottom"
                                style="@GetOptionStyle(optBottom, isSelected, isCorrect)"
                                disabled="@(!_isAcceptingInput || _answerSelected)"
                                @onclick="@(() => SelectAnswer(optBottom))">
                            <div class="d-flex align-center gap-2 gap-sm-3" style="min-width: 0;">
                                <span class="kbd-pill-arrow">↓</span>
                                <span class="quiz-option-text">@GetOptionText(optBottom)</span>
                            </div>
                            @if (_answerSelected)
                            {
                                @if (isCorrect)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" Class="quiz-result-icon" />
                                }
                                else if (isSelected)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Small" Class="quiz-result-icon" />
                                }
                            }
                        </button>
                    }
                </div>
            </MudPaper>
        </div>

        <!-- Keyboard Shortcuts Hint Footer (Desktop / Tablet) -->
        <div class="d-none d-sm-flex align-center justify-center flex-wrap gap-2 gap-sm-4 text-center mt-2" style="font-size: 0.8rem; color: #78716C;">
            <div class="d-flex align-center gap-1.5">
                <span class="kbd-pill-arrow" style="width: 24px; height: 24px; font-size: 0.9rem;">↑</span>
                <span class="kbd-pill-arrow" style="width: 24px; height: 24px; font-size: 0.9rem;">←</span>
                <span class="kbd-pill-arrow" style="width: 24px; height: 24px; font-size: 0.9rem;">↓</span>
                <span class="kbd-pill-arrow" style="width: 24px; height: 24px; font-size: 0.9rem;">→</span>
                <span class="ml-1 font-weight-bold">Flechas o 1-4</span>
            </div>
            <span class="d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Rounded.Bolt" Size="Size.Small" Style="color: #E0872E;" />
                <span>Avanza automáticamente al responder</span>
            </span>
        </div>
    </div>
}

</div>

@code {
    private int _questionCount = 10;
    private string _quizType = "SpanishToEnglish";
    private int _frequencyScope = 500;

    private bool _quizStarted = false;
    private bool _quizComplete = false;
    private bool _answerSelected = false;
    private string _transitionClass = "";
    private bool _isTransitioning = false;
    private bool _isAcceptingInput = true;

    private List<QuizQuestion> _questions = new();
    private int _currentQuestionIndex = 0;
    private QuizQuestion? _currentQuestion;
    private SpanishWord? _selectedAnswer;

    private string GetTransitionClass() => _transitionClass;

    private int _correctAnswers = 0;
    private int _currentStreak = 0;
    private double _accuracy = 0;
    private List<SpanishWord> _missedWords = new();

    private CancellationTokenSource? _autoAdvanceCts;
    private DotNetObjectReference<Quiz>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("quizKeyboardHandler.init", _dotNetRef);
    }

    [JSInvokable]
    public void HandleKeyDown(string key)
    {
        if (!_quizStarted || _quizComplete || _isTransitioning || !_isAcceptingInput) return;

        if (!_answerSelected && _currentQuestion != null)
        {
            int index = key switch
            {
                "ArrowUp" or "1" or "w" or "W" => 0,       // Top
                "ArrowLeft" or "2" or "a" or "A" => 1,     // Left
                "ArrowRight" or "3" or "d" or "D" => 2,    // Right
                "ArrowDown" or "4" or "s" or "S" => 3,     // Bottom
                _ => -1
            };

            if (index >= 0 && index < _currentQuestion.Options.Count)
            {
                _ = SelectAnswer(_currentQuestion.Options[index]);
            }
        }
        else if (_answerSelected)
        {
            // If already answered, pressing any key cancels the pause and triggers the transition immediately!
            SkipAdvanceDelay();
        }
    }

    private void StartQuiz()
    {
        var pool = WordService.GetWordsByFrequency(_frequencyScope);
        if (pool.Count < 4)
        {
            pool = WordService.GetAllWords();
        }

        var selectedWords = pool.OrderBy(_ => Random.Shared.Next()).Take(_questionCount).ToList();
        _questions = new List<QuizQuestion>();

        foreach (var word in selectedWords)
        {
            var isSpanishToEnglish = _quizType switch
            {
                "SpanishToEnglish" => true,
                "EnglishToSpanish" => false,
                _ => Random.Shared.Next(2) == 0
            };

            var wrongOptions = WordService.GetRandomWords(3, new List<int> { word.Id });
            var options = new List<SpanishWord> { word };
            options.AddRange(wrongOptions);
            options = options.OrderBy(_ => Random.Shared.Next()).ToList();

            _questions.Add(new QuizQuestion
            {
                Word = word,
                Options = options,
                IsSpanishToEnglish = isSpanishToEnglish
            });
        }

        _currentQuestionIndex = 0;
        _correctAnswers = 0;
        _currentStreak = 0;
        _missedWords.Clear();
        _quizStarted = true;
        _quizComplete = false;
        _answerSelected = false;
        _transitionClass = "";
        _isTransitioning = false;
        _isAcceptingInput = true;
        _currentQuestion = _questions.Count > 0 ? _questions[0] : null;

        if (_currentQuestion != null && _currentQuestion.IsSpanishToEnglish)
        {
            _ = PlaySpanishAudio(_currentQuestion.Word.Spanish);
        }
    }

    private async Task SelectAnswer(SpanishWord option)
    {
        if (!_isAcceptingInput || _answerSelected || _isTransitioning || _currentQuestion == null) return;

        // Immediately lock input so mobile taps or synthetic ghost clicks cannot register twice
        _isAcceptingInput = false;
        _answerSelected = true;
        _selectedAnswer = option;
        var correct = option.Id == _currentQuestion.Word.Id;

        if (correct)
        {
            _correctAnswers++;
            _currentStreak++;
        }
        else
        {
            _currentStreak = 0;
            if (!_missedWords.Any(w => w.Id == _currentQuestion.Word.Id))
            {
                _missedWords.Add(_currentQuestion.Word);
            }
        }

        await ProgressService.RecordAnswerAsync(_currentQuestion.Word.Id, correct);
        StateHasChanged();

        // Auto-advance with deliberate feedback pause so the user's finger has lifted from the screen
        _autoAdvanceCts?.Cancel();
        _autoAdvanceCts = new CancellationTokenSource();
        var token = _autoAdvanceCts.Token;

        try
        {
            // Generous feedback pause: 520ms on correct, 920ms on incorrect (allows user to see result and completely lift touch)
            int delayMs = correct ? 520 : 920;
            await Task.Delay(delayMs, token);

            if (!token.IsCancellationRequested)
            {
                await AnimateToNextQuestionAsync(token);
            }
        }
        catch (TaskCanceledException)
        {
            // Cancelled by immediate advance or disposal
        }
    }

    private async Task AnimateToNextQuestionAsync(CancellationToken token)
    {
        if (_isTransitioning) return;
        _isTransitioning = true;
        _isAcceptingInput = false;

        // 1. Fade OUT answered question (120ms)
        _transitionClass = "fade-out";
        StateHasChanged();

        try
        {
            await Task.Delay(120, token);
            if (!token.IsCancellationRequested)
            {
                // 2. Switch question while faded out (input remains locked)
                NextQuestion();

                if (!_quizComplete)
                {
                    // 3. Fade IN new question (150ms)
                    _transitionClass = "fade-in";
                    StateHasChanged();

                    await Task.Delay(150, token);
                    _transitionClass = "";
                    StateHasChanged();

                    // 4. Critical Settle Cooldown: wait 200ms before enabling input on the new buttons
                    // This completely absorbs lingering touch releases, ghost clicks, and synthetic mobile taps!
                    await Task.Delay(200, token);
                    _isAcceptingInput = true;
                    StateHasChanged();
                }
            }
        }
        catch (TaskCanceledException)
        {
            _transitionClass = "";
        }
        finally
        {
            _isTransitioning = false;
            if (!_quizComplete && !_answerSelected)
            {
                _isAcceptingInput = true;
            }
        }
    }

    private void SkipAdvanceDelay()
    {
        if (_answerSelected && !_isTransitioning)
        {
            _autoAdvanceCts?.Cancel();
            _autoAdvanceCts = new CancellationTokenSource();
            _ = AnimateToNextQuestionAsync(_autoAdvanceCts.Token);
        }
    }

    private void NextQuestion()
    {
        _autoAdvanceCts?.Cancel();
        if (_currentQuestionIndex < _questions.Count - 1)
        {
            _currentQuestionIndex++;
            _currentQuestion = _questions[_currentQuestionIndex];
            _selectedAnswer = null;
            _answerSelected = false;
            // Note: _isAcceptingInput remains FALSE until fade-in & cooldown complete in AnimateToNextQuestionAsync

            if (_currentQuestion.IsSpanishToEnglish)
            {
                _ = PlaySpanishAudio(_currentQuestion.Word.Spanish);
            }
        }
        else
        {
            FinishQuiz();
        }
    }

    private string GetOptionText(SpanishWord option)
    {
        if (_currentQuestion == null) return "";
        return _currentQuestion.IsSpanishToEnglish ? option.English : option.Spanish;
    }

    private async void FinishQuiz()
    {
        _autoAdvanceCts?.Cancel();
        _quizComplete = true;
        _isAcceptingInput = true;
        _accuracy = _questions.Count > 0 ? (_correctAnswers * 100.0 / _questions.Count) : 0;

        var session = new QuizSession
        {
            Date = DateTime.UtcNow,
            TotalQuestions = _questions.Count,
            CorrectAnswers = _correctAnswers,
            WordIdsTested = _questions.Select(q => q.Word.Id).ToList()
        };
        await ProgressService.RecordQuizSessionAsync(session);
        StateHasChanged();
    }

    private void RestartQuiz()
    {
        _autoAdvanceCts?.Cancel();
        StartQuiz();
    }

    private void ExitQuiz()
    {
        _autoAdvanceCts?.Cancel();
        _quizStarted = false;
        _quizComplete = false;
        _isAcceptingInput = true;
    }

    private void GoHome()
    {
        _autoAdvanceCts?.Cancel();
        NavigationManager.NavigateTo("");
    }

    private async Task PlaySpanishAudio(string text)
    {
        await JS.InvokeVoidAsync("spanishSpeech.speak", text);
    }

    private string GetOptionStyle(SpanishWord option, bool isSelected, bool isCorrect)
    {
        var pointerStyle = !_isAcceptingInput ? "pointer-events: none;" : "";

        if (!_answerSelected) return pointerStyle;

        if (isCorrect)
        {
            return $"{pointerStyle} border-color: #16A34A !important; background-color: #ECFDF5 !important; color: #15803D !important; transform: scale(1.02); box-shadow: 0 4px 12px rgba(22, 163, 74, 0.15);";
        }
        if (isSelected && !isCorrect)
        {
            return $"{pointerStyle} border-color: #DC2626 !important; background-color: #FEF2F2 !important; color: #B91C1C !important;";
        }
        return $"{pointerStyle} opacity: 0.5;";
    }

    private string GetAccuracyColor() => _accuracy switch
    {
        >= 80 => "#16A34A",
        >= 60 => "#E0872E",
        _ => "#D9483B"
    };

    private string GetAccuracyMessage() => _accuracy switch
    {
        100 => "¡Extraordinario! Puntuación perfecta 🌟",
        >= 80 => "¡Excelente trabajo! Dominas este vocabulario.",
        >= 60 => "Buen intento. Sigue practicando para consolidar.",
        _ => "¡Ánimo! La práctica constante hace al maestro."
    };

    public async ValueTask DisposeAsync()
    {
        _autoAdvanceCts?.Cancel();
        _autoAdvanceCts?.Dispose();
        if (_dotNetRef != null)
        {
            await JS.InvokeVoidAsync("quizKeyboardHandler.dispose");
            _dotNetRef.Dispose();
        }
    }

    private class QuizQuestion
    {
        public required SpanishWord Word { get; set; }
        public required List<SpanishWord> Options { get; set; }
        public bool IsSpanishToEnglish { get; set; }
    }
}
