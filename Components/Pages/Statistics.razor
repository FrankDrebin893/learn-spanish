@page "/statistics"
@using SpanishWordLearner.Models
@using SpanishWordLearner.Services
@inject WordService WordService
@inject ProgressService ProgressService
@inject IJSRuntime JS

<PageTitle>Estadísticas de Aprendizaje | Aprende Español</PageTitle>

<div class="mb-5 pt-1">
    <MudText Typo="Typo.h3" Style="font-weight: 800; color: #1C1917; letter-spacing: -0.02em; font-size: clamp(1.65rem, 5vw, 2.5rem); line-height: 1.15;" Class="mb-1">
        Tus Estadísticas
    </MudText>
    <MudText Typo="Typo.body1" Style="color: #57534E; font-size: 0.95rem;">
        Seguimiento detallado de retención, volumen de estudio y precisión por palabra.
    </MudText>
</div>

@if (_loading)
{
    <div class="d-flex justify-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <!-- Primary Highlight Card: Mastery & Coverage Milestone -->
    <div class="tierra-hero-card pa-5 pa-sm-8 mb-5">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-3 mb-sm-4 gap-2">
            <div>
                <span class="d-block" style="font-size: 0.78rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">
                    Vocabulario Dominado
                </span>
                <div class="d-flex align-baseline gap-2 mt-1">
                    <span class="metric-value" style="font-size: clamp(2.2rem, 7vw, 3rem); font-weight: 800; color: #D9483B; line-height: 1;">
                        @_progress.TotalWordsLearned
                    </span>
                    <span class="tabular-numbers" style="font-size: 1.05rem; font-weight: 600; color: #78716C;">
                        / @WordService.TotalWordCount palabras
                    </span>
                </div>
            </div>

            <div class="d-flex flex-column align-start align-sm-end">
                <span class="tabular-numbers" style="font-size: clamp(1.25rem, 4vw, 1.5rem); font-weight: 800; color: #1C1917;">
                    @((_progress.TotalWordsLearned * 100.0 / Math.Max(1, WordService.TotalWordCount)).ToString("F1"))%
                </span>
                <span style="font-size: 0.78rem; font-weight: 600; color: #78716C;">
                    del diccionario total
                </span>
            </div>
        </div>

        <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Medium"
                           Value="@(_progress.TotalWordsLearned * 100.0 / Math.Max(1, WordService.TotalWordCount))"
                           Style="height: 8px; background-color: #EBE6DE;" />
    </div>

    <!-- Supporting Metrics Overview -->
    <MudPaper Elevation="0" Class="tierra-card pa-3 px-sm-6 mb-5">
        <MudGrid Spacing="2">
            <MudItem xs="4">
                <div class="pa-1 pa-sm-2 text-center">
                    <span class="d-block" style="font-size: 0.68rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.03em;">Vistas</span>
                    <span class="metric-value d-block" style="font-size: clamp(1.3rem, 4.5vw, 1.85rem); font-weight: 800; color: #1C1917; line-height: 1.2;">@_progress.WordStats.Count</span>
                    <span style="font-size: 0.72rem; color: #78716C;">estudiadas</span>
                </div>
            </MudItem>
            <MudItem xs="4">
                <div class="pa-1 pa-sm-2 text-center" style="border-left: 1px solid #F3EFEA;">
                    <span class="d-block" style="font-size: 0.68rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.03em;">Pruebas</span>
                    <span class="metric-value d-block" style="font-size: clamp(1.3rem, 4.5vw, 1.85rem); font-weight: 800; color: #1C1917; line-height: 1.2;">@_progress.TotalQuizzesTaken</span>
                    <span style="font-size: 0.72rem; color: #78716C;">hechas</span>
                </div>
            </MudItem>
            <MudItem xs="4">
                <div class="pa-1 pa-sm-2 text-center" style="border-left: 1px solid #F3EFEA;">
                    <span class="d-block" style="font-size: 0.68rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.03em;">Precisión</span>
                    <span class="metric-value d-block" style="font-size: clamp(1.3rem, 4.5vw, 1.85rem); font-weight: 800; color: @(_progress.OverallAccuracy >= 0.7 ? "#16A34A" : "#1C1917"); line-height: 1.2;">
                        @((_progress.OverallAccuracy * 100).ToString("F0"))%
                    </span>
                    <span style="font-size: 0.72rem; color: #78716C;">aciertos</span>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Progress Breakdown & History -->
    <MudGrid Spacing="3" Class="mb-5">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="tierra-card pa-5 h-100">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700; color: #1C1917;">Cobertura de Vocabulario</MudText>

                <div class="mb-4">
                    <div class="d-flex justify-space-between mb-1" style="font-size: 0.85rem; font-weight: 600;">
                        <span style="color: #1C1917;">Palabras Dominadas</span>
                        <span class="tabular-numbers" style="color: #D9483B; font-weight: 700;">@_progress.TotalWordsLearned / @WordService.TotalWordCount</span>
                    </div>
                    <MudProgressLinear Color="Color.Primary" Rounded="true"
                                       Value="@(_progress.TotalWordsLearned * 100.0 / Math.Max(1, WordService.TotalWordCount))"
                                       Style="height: 8px; background-color: #EBE6DE;" />
                </div>

                <div>
                    <div class="d-flex justify-space-between mb-1" style="font-size: 0.85rem; font-weight: 600;">
                        <span style="color: #1C1917;">Palabras Encontradas</span>
                        <span class="tabular-numbers" style="color: #E0872E; font-weight: 700;">@_progress.WordStats.Count / @WordService.TotalWordCount</span>
                    </div>
                    <MudProgressLinear Color="Color.Secondary" Rounded="true"
                                       Value="@(_progress.WordStats.Count * 100.0 / Math.Max(1, WordService.TotalWordCount))"
                                       Style="height: 8px; background-color: #EBE6DE;" />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="tierra-card pa-5 h-100">
                <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 700; color: #1C1917;">Últimas Pruebas</MudText>

                @if (_progress.QuizHistory.Count == 0)
                {
                    <div class="text-center py-6" style="color: #78716C; font-size: 0.9rem;">
                        No has realizado cuestionarios aún.
                        <div class="mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="quiz" Style="border-radius: 10px; font-weight: 700; text-transform: none;">
                                ¡Hacer una prueba!
                            </MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="responsive-table-scroll">
                        <MudSimpleTable Dense="true" Hover="true" Style="background: transparent;">
                            <thead>
                                <tr style="border-bottom: 1px solid #EBE6DE;">
                                    <th style="font-weight: 700; color: #78716C; font-size: 0.8rem;">FECHA</th>
                                    <th style="font-weight: 700; color: #78716C; font-size: 0.8rem;">ACIERTOS</th>
                                    <th style="font-weight: 700; color: #78716C; font-size: 0.8rem; text-align: right;">PRECISIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var quiz in _progress.QuizHistory.OrderByDescending(q => q.Date).Take(5))
                                {
                                    <tr style="border-bottom: 1px solid #F3EFEA;">
                                        <td class="tabular-numbers" style="font-size: 0.85rem; color: #57534E;">@quiz.Date.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                        <td class="tabular-numbers" style="font-size: 0.85rem; font-weight: 600; color: #1C1917;">@quiz.CorrectAnswers / @quiz.TotalQuestions</td>
                                        <td style="text-align: right;">
                                            <span class="tabular-numbers px-2 py-0.5 rounded-pill" style="@($"background: {(quiz.Accuracy >= 0.7 ? "#ECFDF5" : "#FEF2F2")}; color: {(quiz.Accuracy >= 0.7 ? "#16A34A" : "#DC2626")}; font-weight: 700; font-size: 0.8rem;")">
                                                @((quiz.Accuracy * 100).ToString("F0"))%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Word Performance Table with Filter & Search -->
    <MudPaper Elevation="0" Class="tierra-card pa-4 pa-sm-5 mb-5">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3 mb-4">
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Rendimiento por Palabra</MudText>
                <MudText Typo="Typo.caption" Style="color: #78716C;">Historial individual de aciertos y errores</MudText>
            </div>

            <MudToggleGroup T="string" Value="@_showFilter" ValueChanged="OnFilterChanged" Color="Color.Primary" Size="Size.Small" Style="border-radius: 10px;">
                <MudToggleItem Value="@("all")">Todas (@_allWordStatsCount)</MudToggleItem>
                <MudToggleItem Value="@("learned")">Dominadas</MudToggleItem>
                <MudToggleItem Value="@("struggling")">Difíciles</MudToggleItem>
            </MudToggleGroup>
        </div>

        @if (_filteredWords.Count == 0)
        {
            <div class="text-center py-8" style="color: #78716C;">
                <MudIcon Icon="@Icons.Material.Rounded.SearchOff" Size="Size.Large" Class="mb-2" />
                <p>No hay palabras en esta categoría aún.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="quiz" Class="mt-2" Style="text-transform: none; border-radius: 10px;">
                    Hacer Cuestionario
                </MudButton>
            </div>
        }
        else
        {
            <div class="responsive-table-scroll">
                <MudSimpleTable Dense="true" Hover="true" Style="background: transparent; min-width: 520px;">
                    <thead>
                        <tr style="border-bottom: 2px solid #EBE6DE;">
                            <th style="font-weight: 700; color: #1C1917;">Español</th>
                            <th style="font-weight: 700; color: #1C1917;">Inglés</th>
                            <th style="font-weight: 700; color: #1C1917;">Repasos</th>
                            <th style="font-weight: 700; color: #1C1917;">Precisión</th>
                            <th style="font-weight: 700; color: #1C1917; text-align: right;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _filteredWords.Take(50))
                        {
                            <tr style="border-bottom: 1px solid #F3EFEA;">
                                <td>
                                    <div class="d-flex align-center gap-2">
                                        <strong style="color: #D9483B; font-size: 1rem;">@item.Word.Spanish</strong>
                                        <button class="audio-btn" style="width: 26px; height: 26px;" @onclick="@(() => PlayAudio(item.Word.Spanish))" title="Escuchar">
                                            <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Small" />
                                        </button>
                                    </div>
                                </td>
                                <td style="color: #57534E; font-size: 0.9rem;">@item.Word.English</td>
                                <td class="tabular-numbers" style="font-weight: 600; font-size: 0.85rem; color: #1C1917;">@item.Progress.TimesReviewed</td>
                                <td style="min-width: 100px;">
                                    <div class="d-flex align-center gap-2">
                                        <MudProgressLinear Color="@GetAccuracyProgressColor(item.Progress.Accuracy)"
                                                           Rounded="true" Value="@(item.Progress.Accuracy * 100)"
                                                           Style="height: 6px; flex-grow: 1; background-color: #EBE6DE;" />
                                        <span class="tabular-numbers" style="font-size: 0.75rem; font-weight: 600; min-width: 32px; color: #57534E;">
                                            @((item.Progress.Accuracy * 100).ToString("F0"))%
                                        </span>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    @if (item.Progress.IsLearned)
                                    {
                                        <span class="px-2.5 py-1 rounded-pill" style="background: #ECFDF5; color: #15803D; font-weight: 700; font-size: 0.75rem;">
                                            Dominada
                                        </span>
                                    }
                                    else if (item.Progress.Accuracy < 0.5 && item.Progress.TimesReviewed >= 3)
                                    {
                                        <span class="px-2.5 py-1 rounded-pill" style="background: #FEF2F2; color: #B91C1C; font-weight: 700; font-size: 0.75rem;">
                                            Difícil
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-pill" style="background: #FAF8F5; border: 1px solid #EBE6DE; color: #78716C; font-weight: 600; font-size: 0.75rem;">
                                            En progreso
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>

    <!-- Danger Zone: Reset Progress -->
    <div class="d-flex justify-end">
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ShowResetConfirm"
                   StartIcon="@Icons.Material.Rounded.DeleteForever"
                   Style="border-radius: 10px; text-transform: none; font-weight: 600; border-color: #FECACA;">
            Reiniciar Todo el Progreso
        </MudButton>
    </div>

    <!-- Reset Confirmation Dialog -->
    <MudDialog @bind-Visible="_showResetConfirm">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Rounded.Warning" Color="Color.Error" />
                <MudText Typo="Typo.h6" Style="font-weight: 700;">¿Reiniciar todo el progreso?</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <MudText Typo="Typo.body2" Class="mb-3">
                Esta acción eliminará permanentemente todas tus palabras dominadas, historial de pruebas y estadísticas guardadas en este navegador.
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Error">
                Esta acción no se puede deshacer.
            </MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CancelReset" Variant="Variant.Text">Cancelar</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmReset" Style="font-weight: 700;">
                Sí, reiniciar progreso
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private bool _loading = true;
    private UserProgress _progress = new();
    private string _showFilter = "all";
    private int _allWordStatsCount = 0;
    private List<(SpanishWord Word, WordProgress Progress)> _filteredWords = new();
    private bool _showResetConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProgressData();
    }

    private async Task LoadProgressData()
    {
        _loading = true;
        _progress = await ProgressService.GetProgressAsync();
        _allWordStatsCount = _progress.WordStats.Count;
        UpdateFilteredWords();
        _loading = false;
    }

    private void OnFilterChanged(string filter)
    {
        _showFilter = filter;
        UpdateFilteredWords();
    }

    private void UpdateFilteredWords()
    {
        var allWords = WordService.GetAllWords();
        var wordProgressList = new List<(SpanishWord Word, WordProgress Progress)>();

        foreach (var kvp in _progress.WordStats)
        {
            var word = allWords.FirstOrDefault(w => w.Id == kvp.Key);
            if (word != null)
            {
                wordProgressList.Add((word, kvp.Value));
            }
        }

        _filteredWords = _showFilter switch
        {
            "learned" => wordProgressList.Where(x => x.Progress.IsLearned).ToList(),
            "struggling" => wordProgressList.Where(x => x.Progress.Accuracy < 0.5 && x.Progress.TimesReviewed >= 3).ToList(),
            _ => wordProgressList.OrderByDescending(x => x.Progress.LastReviewed).ToList()
        };
    }

    private async Task PlayAudio(string text)
    {
        await JS.InvokeVoidAsync("spanishSpeech.speak", text);
    }

    private void ShowResetConfirm() => _showResetConfirm = true;
    private void CancelReset() => _showResetConfirm = false;

    private async Task ConfirmReset()
    {
        _showResetConfirm = false;
        await ProgressService.ResetProgressAsync();
        await LoadProgressData();
    }

    private Color GetAccuracyChipColor(double accuracy) => accuracy switch
    {
        >= 0.8 => Color.Success,
        >= 0.6 => Color.Warning,
        _ => Color.Error
    };

    private Color GetAccuracyProgressColor(double accuracy) => accuracy switch
    {
        >= 0.7 => Color.Success,
        >= 0.4 => Color.Warning,
        _ => Color.Error
    };
}
