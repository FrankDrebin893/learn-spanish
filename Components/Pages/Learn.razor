@page "/learn"
@using SpanishWordLearner.Models
@using SpanishWordLearner.Services
@inject WordService WordService
@inject ProgressService ProgressService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Aprender Palabras | Aprende Español</PageTitle>

@if (_currentWord == null)
{
    <div class="d-flex justify-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <div class="d-flex flex-column align-center" style="max-width: 540px; margin: 0 auto;">
        <!-- Top Controls & Session Progress -->
        <div class="d-flex justify-space-between align-center w-100 mb-2 px-1">
            <div class="d-flex align-baseline gap-2">
                <span class="tabular-numbers" style="font-size: 0.92rem; font-weight: 700; color: #1C1917;">
                    Palabra @(_currentIndex + 1)
                </span>
                <span class="tabular-numbers" style="font-size: 0.8rem; font-weight: 500; color: #78716C;">
                    de @_words.Count
                </span>
            </div>
            <div class="d-flex align-center gap-1">
                <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" OnClick="PreviousWord"
                               Disabled="@(_currentIndex == 0)" aria-label="Palabra anterior" />
                <MudIconButton Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" OnClick="NextWord"
                               Disabled="@(_currentIndex >= _words.Count - 1)" aria-label="Siguiente palabra" />
            </div>
        </div>

        <MudProgressLinear Color="Color.Primary" Rounded="true"
                           Value="@((_currentIndex + 1) * 100.0 / _words.Count)"
                           Class="mb-5 w-100" Style="height: 6px; background-color: #EBE6DE;" />

        <!-- Main Flashcard -->
        <div class="flashcard-container w-100 mb-5">
            <div class="flashcard-inner">
                <!-- Card Meta Bar -->
                <div class="d-flex justify-space-between align-center w-100 pb-2">
                    <span class="tabular-numbers" style="font-size: 0.78rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">
                        Frecuencia #@_currentWord.FrequencyRank
                    </span>
                    <span style="font-size: 0.82rem; font-weight: 600; color: #E0872E; font-style: italic;">
                        @_currentWord.PartOfSpeech
                    </span>
                </div>

                <!-- Word Stage (Primary Focus) -->
                <div class="d-flex flex-column align-center my-auto py-4 text-center w-100">
                    <div class="d-flex align-center justify-center gap-3 mb-2 flex-wrap">
                        <span class="word-display">@_currentWord.Spanish</span>
                        <button class="audio-btn" @onclick="PlayAudio" title="Escuchar pronunciación nativa">
                            <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Medium" />
                        </button>
                    </div>

                    @if (!_showTranslation)
                    {
                        <div class="mt-4 pt-2">
                            <span style="color: #78716C; font-size: 0.9rem;">
                                Pulsa <span class="kbd-pill">Espacio</span> o el botón para revelar
                            </span>
                        </div>
                    }
                    else
                    {
                        <!-- Revealed Translation -->
                        <div class="translation-display animate-fadeIn">
                            @_currentWord.English
                        </div>

                        @if (!string.IsNullOrEmpty(_currentWord.ExampleSentence))
                        {
                            <div class="literary-example animate-fadeIn">
                                <div class="literary-example-quote">
                                    "@_currentWord.ExampleSentence"
                                </div>
                                <div class="literary-example-translation">
                                    @_currentWord.ExampleTranslation
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Card Bottom Actions -->
                <div class="w-100 pt-3">
                    @if (!_showTranslation)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                                   OnClick="ShowTranslation" StartIcon="@Icons.Material.Rounded.Visibility"
                                   Style="border-radius: 12px; font-weight: 700; height: 50px; text-transform: none; font-size: 1rem; box-shadow: 0 4px 12px rgba(217, 72, 59, 0.2);">
                            Mostrar Traducción
                        </MudButton>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-center w-100 gap-2">
                            <span style="font-size: 0.82rem; font-weight: 600; color: #78716C;">¿Recordabas el significado?</span>
                            <div class="d-flex gap-3 w-100">
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Size="Size.Large"
                                           OnClick="@(() => RecordFeedback(false))" StartIcon="@Icons.Material.Rounded.Close"
                                           Style="border-radius: 12px; font-weight: 700; height: 48px; text-transform: none; border-color: #DFD7CC; color: #57534E;">
                                    Aún no (1)
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Size="Size.Large"
                                           OnClick="@(() => RecordFeedback(true))" StartIcon="@Icons.Material.Rounded.Check"
                                           Style="border-radius: 12px; font-weight: 700; height: 48px; text-transform: none; color: #FFFFFF; box-shadow: 0 4px 12px rgba(22, 163, 74, 0.2);">
                                    ¡La sé! (2)
                                </MudButton>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Keyboard Shortcuts Hint Footer -->
        <div class="d-flex align-center justify-center flex-wrap gap-3 py-2 text-center" style="font-size: 0.78rem; color: #78716C;">
            <span><span class="kbd-pill">Espacio</span> Revelar</span>
            <span><span class="kbd-pill">1</span> Repasar</span>
            <span><span class="kbd-pill">2</span> Sabida</span>
            <span><span class="kbd-pill">←</span> / <span class="kbd-pill">→</span> Navegar</span>
        </div>
    </div>
}

@code {
    private List<SpanishWord> _words = new();
    private int _currentIndex = 0;
    private SpanishWord? _currentWord;
    private bool _showTranslation = false;

    private DotNetObjectReference<Learn>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        WordService.OnWordsLoaded += RefreshWords;
        LoadWordList();
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("learnKeyboardHandler.init", _dotNetRef);
    }

    [JSInvokable]
    public void HandleKeyDown(string key)
    {
        switch (key)
        {
            case " ":
            case "Enter":
                if (!_showTranslation)
                {
                    ShowTranslation();
                    StateHasChanged();
                }
                break;
            case "1":
                if (_showTranslation)
                {
                    _ = RecordFeedback(false);
                }
                break;
            case "2":
                if (_showTranslation)
                {
                    _ = RecordFeedback(true);
                }
                break;
            case "ArrowLeft":
                PreviousWord();
                StateHasChanged();
                break;
            case "ArrowRight":
                NextWord();
                StateHasChanged();
                break;
        }
    }

    private void LoadWordList()
    {
        _words = WordService.GetWordsByFrequency(200);
        if (_words.Count > 0)
        {
            _currentWord = _words[_currentIndex];
        }
    }

    private void RefreshWords()
    {
        InvokeAsync(() =>
        {
            LoadWordList();
            StateHasChanged();
        });
    }

    private void ShowTranslation()
    {
        _showTranslation = true;
    }

    private async Task PlayAudio()
    {
        if (_currentWord != null)
        {
            await JS.InvokeVoidAsync("spanishSpeech.speak", _currentWord.Spanish);
        }
    }

    private async Task RecordFeedback(bool known)
    {
        if (_currentWord != null)
        {
            await ProgressService.RecordAnswerAsync(_currentWord.Id, known);
            NextWord();
            StateHasChanged();
        }
    }

    private void NextWord()
    {
        if (_currentIndex < _words.Count - 1)
        {
            _currentIndex++;
            _currentWord = _words[_currentIndex];
            _showTranslation = false;
        }
    }

    private void PreviousWord()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
            _currentWord = _words[_currentIndex];
            _showTranslation = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        WordService.OnWordsLoaded -= RefreshWords;
        if (_dotNetRef != null)
        {
            await JS.InvokeVoidAsync("learnKeyboardHandler.dispose");
            _dotNetRef.Dispose();
        }
    }
}
