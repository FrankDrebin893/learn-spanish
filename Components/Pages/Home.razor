@page "/"
@using SpanishWordLearner.Services
@using SpanishWordLearner.Models
@inject WordService WordService
@inject ProgressService ProgressService
@inject IJSRuntime JS

<PageTitle>Aprende Español | Inicio</PageTitle>

<!-- Hero Header -->
<div class="text-center mb-6 pt-2">
    <MudText Typo="Typo.h3" Class="mb-2" Style="font-weight: 800; color: #1C1917; letter-spacing: -0.02em;">
        Aprende Español por Frecuencia
    </MudText>
    <MudText Typo="Typo.body1" Style="color: #57534E; font-size: 1.05rem; max-width: 580px; margin: 0 auto; line-height: 1.5;">
        Domina las <strong>@(WordService.TotalWordCount.ToString("N0"))</strong> palabras más frecuentes del idioma mediante tarjetas inteligentes, audio nativo y práctica interactiva.
    </MudText>
</div>

@if (!_loaded)
{
    <div class="d-flex justify-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <!-- Primary Focus: Hero Study Card -->
    <div class="tierra-hero-card pa-6 pa-md-8 mb-6">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-4 gap-2">
            <span class="d-inline-flex align-center gap-1 px-3 py-1 rounded-pill" style="background: #FDEEEB; color: #BF3A2E; font-size: 0.8rem; font-weight: 700;">
                <MudIcon Icon="@Icons.Material.Rounded.Star" Size="Size.Small" /> Nivel @GetProficiencyLevel()
            </span>
            <span class="tabular-numbers" style="font-size: 0.85rem; font-weight: 600; color: #78716C;">
                Top 200 palabras esenciales
            </span>
        </div>

        <div class="mb-5">
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #1C1917; letter-spacing: -0.01em;" Class="mb-2">
                Continuar tu Sesión de Estudio
            </MudText>
            <MudText Typo="Typo.body1" Style="color: #57534E; max-width: 540px; font-size: 0.98rem; line-height: 1.5;">
                Estudia tarjetas interactivas organizadas por frecuencia natural de uso con pronunciación nativa y refuerzo activo.
            </MudText>
        </div>

        <div class="d-flex flex-column flex-sm-row align-sm-center justify-space-between gap-4 pt-1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="learn" Size="Size.Large"
                       StartIcon="@Icons.Material.Rounded.PlayArrow"
                       Style="border-radius: 12px; font-weight: 700; font-size: 1rem; padding: 12px 28px; text-transform: none; box-shadow: 0 4px 14px rgba(217, 72, 59, 0.28);">
                Comenzar Estudio Ahora
            </MudButton>

            <div class="d-flex align-center gap-2" style="font-size: 0.85rem; color: #78716C;">
                <MudIcon Icon="@Icons.Material.Rounded.Keyboard" Size="Size.Small" />
                <span>Atajos con <span class="kbd-pill">Espacio</span> y números</span>
            </div>
        </div>

        <!-- Global Progress Milestone Bar -->
        <div class="mt-6 pt-4" style="border-top: 1px solid #F3EFEA;">
            <div class="d-flex justify-space-between mb-1" style="font-size: 0.82rem; font-weight: 600;">
                <span style="color: #78716C;">Progreso hacia la maestría</span>
                <span class="tabular-numbers" style="color: #D9483B; font-weight: 700;">
                    @_wordsLearned de @WordService.TotalWordCount palabras (@_progressPercent.ToString("F1")%)
                </span>
            </div>
            <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Medium"
                               Value="@(_progressPercent)" Style="height: 8px; background-color: #EBE6DE;" />
        </div>
    </div>

    <!-- Metrics Row: Structured, Calm, Tabular -->
    <MudPaper Elevation="0" Class="tierra-card pa-4 px-md-6 mb-6">
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center">
                    <span class="d-block" style="font-size: 0.72rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">Dominadas</span>
                    <span class="metric-value d-block" style="font-size: 1.85rem; font-weight: 800; color: #D9483B; line-height: 1.2;">@_wordsLearned</span>
                    <span style="font-size: 0.75rem; color: #78716C;">palabras sabidas</span>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="border-left: 1px solid #F3EFEA;">
                    <span class="d-block" style="font-size: 0.72rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">Estudiadas</span>
                    <span class="metric-value d-block" style="font-size: 1.85rem; font-weight: 800; color: #1C1917; line-height: 1.2;">@_wordsSeen</span>
                    <span style="font-size: 0.75rem; color: #78716C;">vistas en total</span>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="border-left: 1px solid #F3EFEA;">
                    <span class="d-block" style="font-size: 0.72rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">Cuestionarios</span>
                    <span class="metric-value d-block" style="font-size: 1.85rem; font-weight: 800; color: #1C1917; line-height: 1.2;">@_quizzesTaken</span>
                    <span style="font-size: 0.75rem; color: #78716C;">pruebas hechas</span>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="pa-2 text-center" style="border-left: 1px solid #F3EFEA;">
                    <span class="d-block" style="font-size: 0.72rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">Precisión</span>
                    <span class="metric-value d-block" style="font-size: 1.85rem; font-weight: 800; color: @(_overallAccuracy >= 70 ? "#16A34A" : "#1C1917"); line-height: 1.2;">
                        @_overallAccuracy.ToString("F0")%
                    </span>
                    <span style="font-size: 0.75rem; color: #78716C;">en pruebas</span>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Secondary Activities: Practice & Discovery -->
    <MudGrid Spacing="3" Class="mb-6">
        <!-- Interactive Practice (Quiz) Card -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="tierra-card-subtle pa-6 h-100 d-flex flex-column justify-space-between">
                <div>
                    <div class="d-flex align-center justify-space-between mb-3">
                        <span style="font-size: 0.78rem; font-weight: 700; color: #E0872E; text-transform: uppercase; letter-spacing: 0.04em;">
                            Práctica Rápida
                        </span>
                        <MudIcon Icon="@Icons.Material.Rounded.Quiz" Size="Size.Small" Style="color: #E0872E;" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 700; color: #1C1917;">
                        Cuestionario Interactivo
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #57534E; line-height: 1.5;" Class="mb-4">
                        Comprueba tu retención con retos de opción múltiple, rachas de aciertos y atajos de teclado rápidos.
                    </MudText>
                </div>
                <div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="quiz" FullWidth="true"
                               StartIcon="@Icons.Material.Rounded.CheckCircle"
                               Style="border-radius: 10px; font-weight: 700; text-transform: none; border-color: #D9483B; height: 44px;">
                        Hacer Cuestionario
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        <!-- Featured Word / Discovery Card -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="tierra-card pa-6 h-100 d-flex flex-column justify-space-between">
                @if (_featuredWord != null)
                {
                    <div>
                        <div class="d-flex justify-space-between align-center mb-3">
                            <span style="font-size: 0.78rem; font-weight: 700; color: #78716C; text-transform: uppercase; letter-spacing: 0.04em;">
                                Palabra del Momento
                            </span>
                            <span class="tabular-numbers" style="font-size: 0.75rem; font-weight: 600; color: #78716C;">
                                Frecuencia #@_featuredWord.FrequencyRank
                            </span>
                        </div>

                        <div class="d-flex align-start justify-space-between gap-3 mb-2">
                            <div>
                                <div class="d-flex align-baseline gap-2">
                                    <span style="font-size: 1.75rem; font-weight: 800; color: #1C1917; line-height: 1.2;">
                                        @_featuredWord.Spanish
                                    </span>
                                    <span style="font-size: 0.82rem; font-weight: 500; color: #78716C; font-style: italic;">
                                        @_featuredWord.PartOfSpeech
                                    </span>
                                </div>
                                <span style="font-size: 1rem; color: #D9483B; font-weight: 600;">
                                    @_featuredWord.English
                                </span>
                            </div>
                            <button class="audio-btn" @onclick="PlayFeaturedAudio" title="Escuchar pronunciación">
                                <MudIcon Icon="@Icons.Material.Rounded.VolumeUp" Size="Size.Small" />
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(_featuredWord.ExampleSentence))
                        {
                            <div class="literary-example">
                                <div class="literary-example-quote">
                                    "@_featuredWord.ExampleSentence"
                                </div>
                                <div class="literary-example-translation">
                                    @_featuredWord.ExampleTranslation
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Descubrimiento</MudText>
                        <MudText Typo="Typo.body2" Style="color: #57534E;">Cargando vocabulario...</MudText>
                    </div>
                }

                <div class="pt-3">
                    <a href="learn" class="d-inline-flex align-center gap-1 text-decoration-none" style="color: #D9483B; font-size: 0.85rem; font-weight: 700;">
                        <span>Estudiar más palabras</span>
                        <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" />
                    </a>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Deep Dive Statistics Link Footer -->
    <div class="text-center py-2">
        <a href="statistics" class="d-inline-flex align-center gap-2 text-decoration-none" style="color: #78716C; font-size: 0.88rem; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Rounded.Analytics" Size="Size.Small" />
            <span>Ver historial completo de palabras y estadísticas detalladas</span>
            <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" />
        </a>
    </div>
}

@code {
    private bool _loaded = false;
    private int _wordsLearned = 0;
    private int _wordsSeen = 0;
    private int _quizzesTaken = 0;
    private double _overallAccuracy = 0;
    private double _progressPercent = 0;
    private SpanishWord? _featuredWord;

    protected override async Task OnInitializedAsync()
    {
        WordService.OnWordsLoaded += HandleWordsLoaded;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var progress = await ProgressService.GetProgressAsync();
        _wordsLearned = progress.TotalWordsLearned;
        _wordsSeen = progress.WordStats.Count;
        _quizzesTaken = progress.TotalQuizzesTaken;
        _overallAccuracy = progress.OverallAccuracy * 100.0;

        var total = WordService.TotalWordCount;
        _progressPercent = total > 0 ? (_wordsLearned * 100.0 / total) : 0;

        var randomList = WordService.GetRandomWords(1);
        if (randomList.Count > 0)
        {
            _featuredWord = randomList[0];
        }

        _loaded = true;
    }

    private void HandleWordsLoaded()
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private async Task PlayFeaturedAudio()
    {
        if (_featuredWord != null)
        {
            await JS.InvokeVoidAsync("spanishSpeech.speak", _featuredWord.Spanish);
        }
    }

    private string GetProficiencyLevel()
    {
        return _wordsLearned switch
        {
            >= 2000 => "Avanzado (B2+)",
            >= 1000 => "Intermedio Alto (B1)",
            >= 500 => "Intermedio (A2)",
            >= 100 => "Elemental (A1)",
            _ => "Principiante"
        };
    }
}
