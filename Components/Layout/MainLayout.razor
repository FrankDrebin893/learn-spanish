@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject SpanishWordLearner.Services.ProgressService ProgressService
@inject SpanishWordLearner.Services.AuthService AuthService
@inject IDialogService DialogService
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Style="background-color: #FAF8F5; min-height: 100vh;">
    <!-- Top Navigation Bar -->
    <MudAppBar Elevation="0" Class="app-header" Fixed="true">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center justify-space-between px-3 px-md-4">
            <!-- Brand -->
            <a href="./" class="d-flex align-center text-decoration-none" style="gap: 10px; color: inherit;">
                <div style="width: 36px; height: 36px; background: linear-gradient(135deg, #D9483B 0%, #E0872E 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(217, 72, 59, 0.25); flex-shrink: 0;">
                    <span style="color: #FFFFFF; font-weight: 800; font-size: 19px; line-height: 1; font-family: 'Outfit', sans-serif;">ñ</span>
                </div>
                <div>
                    <span style="font-weight: 700; font-size: 1.1rem; color: #1C1917; letter-spacing: -0.02em; display: block; line-height: 1.15; white-space: nowrap;">Aprende Español</span>
                    <span class="d-none d-sm-block" style="font-size: 0.7rem; color: #78716C; font-weight: 500; letter-spacing: 0.02em;">VOCABULARIO ESENCIAL</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <div class="d-none d-md-flex align-center" style="gap: 6px;">
                <MudButton Variant="Variant.Text" Href="./" OnClick="@(() => NavigationManager.NavigateTo(""))" StartIcon="@Icons.Material.Rounded.Home"
                           Class="px-3 py-2" Style="@GetNavStyle("/")">
                    Inicio
                </MudButton>
                <MudButton Variant="Variant.Text" Href="quiz" StartIcon="@Icons.Material.Rounded.Quiz"
                           Class="px-3 py-2" Style="@GetNavStyle("/quiz")">
                    Cuestionario
                </MudButton>
                <MudButton Variant="Variant.Text" Href="statistics" StartIcon="@Icons.Material.Rounded.Analytics"
                           Class="px-3 py-2" Style="@GetNavStyle("/statistics")">
                    Progreso
                </MudButton>
            </div>

            <!-- Header Quick Badge & Account -->
            <div class="d-flex align-center" style="gap: 8px;">
                <a href="statistics" class="d-flex align-center px-2.5 px-sm-3 py-1 text-decoration-none" style="background: #FAF8F5; border: 1px solid #EBE6DE; border-radius: 20px; gap: 5px; flex-shrink: 0; color: inherit;">
                    <MudIcon Icon="@Icons.Material.Rounded.LocalFireDepartment" Size="Size.Small" Style="color: #D97706;" />
                    <span class="tabular-numbers" style="font-size: 0.82rem; font-weight: 700; color: #1C1917;">
                        @_learnedCount<span class="d-none d-sm-inline"> Palabras</span>
                    </span>
                </a>

                <MudTooltip Text="@(AuthService.IsAuthenticated ? AuthService.CurrentUserEmail : "Sincronización en la nube")">
                    <MudIconButton Icon="@(AuthService.IsAuthenticated ? Icons.Material.Rounded.AccountCircle : Icons.Material.Rounded.CloudQueue)"
                                   OnClick="OpenAuthDialog"
                                   Size="Size.Medium"
                                   Class="account-btn"
                                   Style="@(AuthService.IsAuthenticated ? "color: #D9483B; background: #FDEEEB; border-radius: 50%;" : "color: #78716C; border-radius: 50%;")" />
                </MudTooltip>
            </div>
        </MudContainer>
    </MudAppBar>

    <!-- Main Page Content Area -->
    <MudMainContent Class="app-main-content">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="app-page-container px-3 px-sm-4">
            @Body
        </MudContainer>
    </MudMainContent>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-nav d-flex d-md-none fixed-bottom" aria-label="Navegación principal">
        <a href="./" class="mobile-nav-item @(IsActive("/") ? "active" : "")">
            <MudIcon Icon="@Icons.Material.Rounded.Home" Size="Size.Medium" />
            <span>Inicio</span>
        </a>
        <a href="quiz" class="mobile-nav-item @(IsActive("/quiz") ? "active" : "")">
            <MudIcon Icon="@Icons.Material.Rounded.Quiz" Size="Size.Medium" />
            <span>Cuestionario</span>
        </a>
        <a href="statistics" class="mobile-nav-item @(IsActive("/statistics") ? "active" : "")">
            <MudIcon Icon="@Icons.Material.Rounded.Analytics" Size="Size.Medium" />
            <span>Progreso</span>
        </a>
        <button type="button" class="mobile-nav-item" @onclick="OpenAuthDialog" style="background: none; border: none; font-family: inherit; cursor: pointer;">
            <MudIcon Icon="@(AuthService.IsAuthenticated ? Icons.Material.Rounded.AccountCircle : Icons.Material.Rounded.CloudQueue)" 
                     Size="Size.Medium" 
                     Style="@(AuthService.IsAuthenticated ? "color: #D9483B;" : "")" />
            <span>@(AuthService.IsAuthenticated ? "Cuenta" : "Nube")</span>
        </button>
    </nav>
</MudLayout>

@code {
    private int _learnedCount = 0;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        ProgressService.ProgressUpdated += OnProgressUpdated;
        AuthService.AuthStateChanged += OnAuthStateChanged;

        await RefreshLearnedCountAsync();
    }

    private async void OnProgressUpdated()
    {
        await RefreshLearnedCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthStateChanged()
    {
        await RefreshLearnedCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshLearnedCountAsync()
    {
        var progress = await ProgressService.GetProgressAsync();
        _learnedCount = progress.TotalWordsLearned;
    }

    private async Task OpenAuthDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<SpanishWordLearner.Components.Shared.AuthDialog>("", options);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string href)
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrEmpty(uri) || uri == "/")
            return href == "/" || href == "./" || href == "";
        return href.TrimStart('/') == uri.Split('?')[0];
    }

    private string GetNavStyle(string href)
    {
        if (IsActive(href))
        {
            return "border-radius: 10px; text-transform: none; font-weight: 700; font-size: 0.95rem; background: #FDEEEB; color: #D9483B;";
        }
        return "border-radius: 10px; text-transform: none; font-weight: 500; font-size: 0.95rem; color: #57534E;";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ProgressService.ProgressUpdated -= OnProgressUpdated;
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#D9483B",
            PrimaryDarken = "#BF3A2E",
            PrimaryLighten = "#FDEEEB",
            Secondary = "#E0872E",
            SecondaryDarken = "#B45309",
            SecondaryLighten = "#FEF3E7",
            Tertiary = "#1E293B",
            Success = "#16A34A",
            Error = "#DC2626",
            Warning = "#D97706",
            Info = "#2563EB",
            Background = "#FAF8F5",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            TextPrimary = "#1C1917",
            TextSecondary = "#57534E",
            LinesDefault = "#EBE6DE",
            Divider = "#EBE6DE"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Outfit", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "14px"
        }
    };
}
